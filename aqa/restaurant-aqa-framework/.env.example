# Скопіюйте у .env і вкажіть адреси свого стенду.
# Будь-яке значення можна передати змінною оточення (так робить CI).

# Розгорнутий фронтенд (CloudFront) і stage API Gateway
BASE_URL=https://your-distribution.cloudfront.net
API_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/develop

# Користувачі створюються під час прогону: aqa.<run>.<роль>.<випадкове>@example.com
TEST_EMAIL_PREFIX=aqa
TEST_EMAIL_DOMAIN=example.com

# Браузер для UI-сценаріїв
HEADLESS=true
SLOW_MO_MS=0
UI_TIMEOUT_MS=20000
# скільки чекають перевірки Expect(...)
EXPECT_TIMEOUT_MS=10000
# on | off | retain-on-failure
TRACE=retain-on-failure
# on | off | retain-on-failure
VIDEO=off
# скільки сценаріїв іде одночасно і скільки з них можуть тримати відкритий браузер
TEST_PARALLELISM=3
UI_MAX_SESSIONS=2
